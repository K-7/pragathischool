/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=()

# Vite fingerprints these filenames, so they can be cached indefinitely.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Brand artwork is versioned by hand, so cache it for a week rather than
# forever — a logo swap should reach visitors without a filename change.
/brand/*
  Cache-Control: public, max-age=604800

/og-default.jpg
  Cache-Control: public, max-age=604800
